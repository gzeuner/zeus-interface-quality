{
  "format": "csv",
  "version": 1,
  "encoding": "UTF-8",
  "delimiter": ";",
  "decimalSeparator": ",",
  "header": [
    "rentalId",
    "station",
    "startDate",
    "durationMinutes",
    "distanceKm",
    "bikeType",
    "contactEmail"
  ],
  "minRecords": 1,
  "maxRecords": 50,
  "uniqueBy": ["rentalId"],
  "fileNamePattern": "^fictional-bicycle-rentals(-invalid)?\\.csv$",
  "correction": {
    "enabled": false
  },
  "columns": [
    {
      "name": "rentalId",
      "type": "string",
      "required": true,
      "pattern": "^BIKE-[0-9]{3}$"
    },
    {
      "name": "station",
      "type": "string",
      "required": true,
      "minLength": 3,
      "maxLength": 40
    },
    {
      "name": "startDate",
      "type": "date",
      "required": true
    },
    {
      "name": "durationMinutes",
      "type": "integer",
      "required": true,
      "minimum": 1,
      "maximum": 1440
    },
    {
      "name": "distanceKm",
      "type": "decimal",
      "required": true,
      "minimum": 0,
      "maximum": 500,
      "pattern": "^[0-9]{1,3},[0-9]{2}$"
    },
    {
      "name": "bikeType",
      "type": "string",
      "required": true,
      "pattern": "^(city|cargo|electric)$"
    },
    {
      "name": "contactEmail",
      "type": "email",
      "required": true
    }
  ]
}

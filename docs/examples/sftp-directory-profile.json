{
  "format": "sftp",
  "version": 2,
  "host": "sftp.example.test",
  "port": 22,
  "username": "quality-reader",
  "remoteDirectory": "/incoming",
  "filePattern": "^delivery-[0-9]{8}\\.json$",
  "knownHosts": "known_hosts",
  "privateKey": "id_ed25519",

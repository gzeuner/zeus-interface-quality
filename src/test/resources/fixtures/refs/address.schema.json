{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "address.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "street",
    "postalCode",
    "city"
  ],
  "properties": {
    "street": {
      "type": "string",
      "minLength": 1
    },
    "postalCode": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "city": {
      "type": "string",
      "minLength": 1
    }
  }
}
